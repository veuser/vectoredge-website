# .gitignore for vectoredge-website

# Node dependencies
node_modules/

# Build outputs
dist/
build/
.vite/
out/

# Vite / public build
public/build/

# Local environment files
.env
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor directories and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# Test coverage
coverage/

# Temporary files
*.tgz
